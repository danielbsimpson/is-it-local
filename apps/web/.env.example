# Base URL of the Phase 1 FastAPI backend.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# OpenStreetMap raster tile template used by the business map (free, no key).
NEXT_PUBLIC_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png

# Nominatim (OpenStreetMap) geocoding endpoint for free-text location search.
NEXT_PUBLIC_GEOCODE_URL=https://nominatim.openstreetmap.org/search
