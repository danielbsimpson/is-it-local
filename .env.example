# Is It Local — environment variables
#
# Copy this file to `.env` and fill in real values. Never commit `.env`.

# PostgreSQL/PostGIS connection string used by the backend API.
# Format: postgresql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/is_it_local

# Foursquare Places API key used to seed the business catalog.
FOURSQUARE_API_KEY=your-foursquare-api-key

# API key for the LLM provider used in the enrichment pipeline.
LLM_API_KEY=your-llm-api-key

# Web-search API key used during enrichment to research ownership signals.
SEARCH_API_KEY=your-search-api-key
