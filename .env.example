# Is It Local — environment variables (local-first PoC)
#
# Copy this file to `.env` and adjust values. Never commit `.env`.
# The PoC runs entirely on your machine: no paid API keys are required.

# PostgreSQL/PostGIS connection string used by the backend API.
# Format: postgresql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/is_it_local

# Local LLM served by llama.cpp with an OpenAI-compatible API.
# Start llama.cpp's server (e.g. `llama-server -m <model.gguf> --port 8080`).
LLM_BASE_URL=http://localhost:8080/v1
LLM_MODEL=local-model

# Self-hosted SearXNG instance used to gather ownership signals during enrichment.
SEARXNG_BASE_URL=http://localhost:8888

# Per-service request budget for the enrichment pipeline (llama.cpp / SearXNG).
PROVIDER_RATE_LIMIT_PER_MIN=60
